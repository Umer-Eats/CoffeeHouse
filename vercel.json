{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(student|settings|ai-assistant)\\.html", "dest": "api/index.js" },
    { "src": "/", "dest": "api/index.js" },
    { "src": "/(art\\.js|app\\.js)", "dest": "/public/$1" }
  ]
}
