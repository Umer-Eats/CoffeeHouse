{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/student\\.html", "dest": "server.js" },
    { "src": "/settings\\.html", "dest": "server.js" },
    { "src": "/ai-assistant\\.html", "dest": "server.js" },
    { "src": "/", "dest": "server.js" }
  ]
}
