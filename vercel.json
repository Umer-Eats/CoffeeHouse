{
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/(student|settings|ai-assistant)\\.html", "destination": "/server.js" },
    { "source": "/(art|app)\\.js", "destination": "/server.js" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
