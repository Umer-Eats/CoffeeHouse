# CoffeeHouse server configuration.
# Copy this file to `.env` and fill in your real values.

# ---- Web server ----
PORT=3000

# ---- Database (Turso / libSQL) ----
# Option A: Turso (cloud, recommended for Vercel)
# 1. Sign up at https://turso.tech (free tier: 500 DBs, 9GB storage)
# 2. Create a database:  turso db create coffeehouse
# 3. Get the URL:        turso db show coffeehouse --url
# 4. Create an auth token: turso db tokens create coffeehouse
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
# Option B: Local SQLite file (for development, no token needed)
# TURSO_DATABASE_URL=file:./data/coffeehouse.db

# ---- Firebase Authentication (REQUIRED for Google sign-in) ----
# 1. Create a Firebase project: https://console.firebase.google.com
# 2. Enable Google sign-in: Authentication > Sign-in method > Google
# 3. Add your domain to Authentication > Settings > Authorized domains
#    (e.g. http://localhost:3000 — also add your production domain later)
# 4. Add a Web app: Project settings > Your apps > Web (</>) to get the web
#    config, then paste it below as JSON:
FIREBASE_WEB_CONFIG={"apiKey":"YOUR_API_KEY","authDomain":"coffeehouse.firebaseapp.com","projectId":"coffeehouse","storageBucket":"coffeehouse.appspot.com","messagingSenderId":"000000000000","appId":"1:000000000000:web:xxxxxxxx"}
# 5. Generate a service account key: Project settings > Service accounts >
#    Generate new private key (downloads a JSON file), then paste the raw JSON
#    below (Vercel cannot read local files):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"coffeehouse",...}
#    Alternative: set GOOGLE_APPLICATION_CREDENTIALS env var in Vercel dashboard.

# ---- Google Gemini (used by BARISTI AI) ----
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ---- Gemini Notebook Enterprise / NotebookLM (used by BREWER AI) ----
# The consumer NotebookLM product has no public API. Brewer uses Gemini for
# study docs out of the box. To also create a real NotebookLM notebook per brew,
# enable the enterprise API below (requires a Gemini Notebook Enterprise license).
# Set NOTEBOOKLM_ACCESS_TOKEN to the output of:  gcloud auth print-access-token
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_PROJECT=000000000000
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_ACCESS_TOKEN=

# ---- Development only ----
# When true, shows a "dev login" box that creates real accounts without Firebase,
# so you can try the app before configuring authentication. Disable in production.
DEV_LOGIN=false

# ---- Vercel production settings ----
# Set COOKIE_SECURE=true when deploying to HTTPS (Vercel)
COOKIE_SECURE=true
